---
import BaseLayout  from '../layouts/BaseLayout.astro';
import {site} from '../data/site';

const skills =['HTML','CSS','Javascript','Python','Django','MySql','Astro'];


---
<BaseLayout title="About">
    <h1>About Me</h1>
    <p>{site.bio}</p>
    <h2>Skills</h2>
    <div class="tags">
    {skills.map((skill)=> <span class="tag">{skill}</span>)}
    </div>

</BaseLayout>
